# --- LLM (pick one provider) ---
LLM_PROVIDER=anthropic          # anthropic | openai (openai also covers Gemini/Groq/Together/Ollama via LLM_BASE_URL)
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini example
# --- Gnani speech (STT + TTS) ---
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
# --- Dataset location (folder that contains kb/, data/, tools/) ---
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
